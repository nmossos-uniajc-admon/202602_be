PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=pguser
DB_PASSWORD=password
DB_NAME=gym

# Auth / JWT (obligatorios: el servidor no arranca sin los secretos)
# Genérelos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambiar-por-secreto-aleatorio-de-48-bytes-hex
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-aleatorio-de-48-bytes-hex
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Seed del primer administrador: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar-esta-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Gym

# Seed de la rutina de ejemplo: npm run seed:routine
SEED_OWNER_EMAIL=trainer.seed@gym.local
SEED_OWNER_PASSWORD=Trainer123!
